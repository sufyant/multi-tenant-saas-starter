{
  "name": "multi-tenant-saas-starter",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "lint": "biome check",
    "format": "biome check --write",
    "generate": "pnpm ui:tokens && pnpm api:permissions && pnpm api:codegen && pnpm api:openapi && pnpm api:generate",
    "ui:tokens": "pnpm --filter @repo/ui generate:tokens",
    "api:permissions": "pnpm --filter @repo/api generate:permissions",
    "api:generate": "pnpm --filter @repo/api-client generate",
    "api:codegen": "pnpm --filter @repo/api codegen",
    "api:openapi": "pnpm --filter @repo/api generate:openapi",
    "github:apply": "scripts/github/apply-settings.sh",
    "github:check": "scripts/github/apply-settings.sh --check",
    "railway:plan": "railway config plan",
    "railway:apply": "railway config apply",
    "clerk:plan": "scripts/clerk/config.sh plan",
    "clerk:apply": "scripts/clerk/config.sh apply"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "railway": "^3.13.1",
    "turbo": "^2.10.12",
    "typescript": "^5"
  },
  "intent": {
    "skills": [
      "@tanstack/react-table#getting-started",
      "@tanstack/react-table#table-state",
      "@tanstack/table-core#core",
      "@tanstack/table-core#custom-features",
      "@tanstack/table-core#table-features",
      "@tanstack/table-core#table-state"
    ]
  }
}
