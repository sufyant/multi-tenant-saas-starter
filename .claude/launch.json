{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@repo/web", "dev"],
      "port": 3000
    },
    {
      "name": "platform",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@repo/platform", "dev"],
      "port": 3001
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "apps/api/src/Api", "--urls", "http://localhost:5050"],
      "port": 5050
    }
  ]
}
