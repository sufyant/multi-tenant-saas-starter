{
  "auth_access_control": {
    "sign_up_mode": "restricted"
  },
  "auth_email": {
    "used_for_sign_in": true,
    "sign_in_strategies": ["email_code"],
    "verify_at_sign_up": true,
    "verification_strategies": ["email_code"]
  },
  "auth_password": {
    "enabled": false,
    "required": false
  },
  "connection_oauth_google": {
    "enabled": true,
    "authenticatable": true
  },
  "connection_oauth_microsoft": {
    "enabled": true,
    "authenticatable": true
  },
  "user_model": {
    "first_name": { "enabled": false, "required": false },
    "last_name": { "enabled": false, "required": false }
  },
  "auth_multi_factor": {
    "authenticator_app": { "enabled": true },
    "backup_code": { "enabled": true }
  },
  "auth_attack_protection": {
    "bot_protection": { "captcha_enabled": true },
    "enumeration_protection": "strict"
  }
}
