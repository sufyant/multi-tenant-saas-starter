{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!.turbo",
      "!.claude",
      "!apps/api",
      "!**/*.gen.ts",
      "!**/*.gen.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "fetch": "Call the API through @repo/api-client. Only its mutator and the BFF route handler call fetch (decision 10 in docs/frontend/ARCHITECTURE.md)."
            }
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "lucide-react": "Import an icon through the Icon component of @repo/ui (rule N in docs/frontend/ARCHITECTURE.md).",
              "sonner": "Use the Toast component of @repo/ui (decision 8 in docs/frontend/ARCHITECTURE.md).",
              "@tanstack/react-table": "Use the Table component of @repo/ui (decision 3 in docs/frontend/ARCHITECTURE.md)."
            },
            "patterns": [
              {
                "group": ["@repo/api-client"],
                "importNamePattern": "use[A-Z].*",
                "message": "Call useQuery with the generated options, such as getListMembersQueryOptions (decision 2 in docs/frontend/ARCHITECTURE.md)."
              }
            ]
          }
        }
      },
      "suspicious": {
        "noImportCycles": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/public/**/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/ui/src/components/ui/**",
        "apps/web/src/components/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useFocusableInteractive": "off",
            "useSemanticElements": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "suspicious": {
            "noDocumentCookie": "off"
          },
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/api-client/src/mutator.ts",
        "apps/*/src/app/api/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/icon/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "sonner": "Use the Toast component of @repo/ui (decision 8 in docs/frontend/ARCHITECTURE.md).",
                  "@tanstack/react-table": "Use the Table component of @repo/ui (decision 3 in docs/frontend/ARCHITECTURE.md)."
                },
                "patterns": [
                  {
                    "group": ["@repo/api-client"],
                    "importNamePattern": "use[A-Z].*",
                    "message": "Call useQuery with the generated options, such as getListMembersQueryOptions (decision 2 in docs/frontend/ARCHITECTURE.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/toast/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "lucide-react": "Import an icon through the Icon component of @repo/ui (rule N in docs/frontend/ARCHITECTURE.md).",
                  "@tanstack/react-table": "Use the Table component of @repo/ui (decision 3 in docs/frontend/ARCHITECTURE.md)."
                },
                "patterns": [
                  {
                    "group": ["@repo/api-client"],
                    "importNamePattern": "use[A-Z].*",
                    "message": "Call useQuery with the generated options, such as getListMembersQueryOptions (decision 2 in docs/frontend/ARCHITECTURE.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/table/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "lucide-react": "Import an icon through the Icon component of @repo/ui (rule N in docs/frontend/ARCHITECTURE.md).",
                  "sonner": "Use the Toast component of @repo/ui (decision 8 in docs/frontend/ARCHITECTURE.md)."
                },
                "patterns": [
                  {
                    "group": ["@repo/api-client"],
                    "importNamePattern": "use[A-Z].*",
                    "message": "Call useQuery with the generated options, such as getListMembersQueryOptions (decision 2 in docs/frontend/ARCHITECTURE.md)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
