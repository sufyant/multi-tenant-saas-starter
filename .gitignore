# Dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
out/

# Expo / React Native
.expo/
dist/
web-build/

# .NET
bin/
obj/
# Test results, hang dumps and diagnostic logs. A dump holds connection strings and keys.
TestResults/
*.user

# Env files
.env
.env.local
.env.*.local

# Clerk's keyless mode writes temporary keys here. The other files in .clerk/ are settings.
.clerk/keyless.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Turborepo
.turbo/

# Build output
dist/
build/

# Agent skills live in .claude/skills as real directories, installed with
# `skills add <pkg> --copy -a claude-code`. Without --copy the tool instead
# creates a store in .agents/ plus symlinks, and a second malformed copy in
# agent/ for agents we do not use. Neither belongs in the repo if it reappears.
.agents/
agent/

# Superpowers subagent-driven-development scratch
.superpowers/
# Local application settings
appsettings.Development.json
appsettings.*.local.json

# Certificates. A database root certificate belongs outside the repository (docs/deployment.md, section 4, step 9).
*.crt
