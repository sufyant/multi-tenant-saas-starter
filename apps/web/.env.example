# The API's origin. A server variable: the BFF route handler calls it, the browser never sees it (F6, F7).
API_URL=http://localhost:8080
# Read at run time, not at build time, so one image serves every environment (F7).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Error tracking (F55). Without a DSN the app sends no error. With one, the environment is staging or production. Both are read
# at run time; the server gives them to the browser.
ERROR_TRACKING_DSN=
ERROR_TRACKING_ENVIRONMENT=
