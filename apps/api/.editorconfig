root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning

# N8: the namespace follows the folder, so a moved file that keeps its old namespace fails the build (IDE0130, Microsoft Learn,
# "Namespace does not match folder structure"). Generated code is outside the rule: its sections below set generated_code.
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = warning

# CA1716 checks types and members, not namespaces. Our namespaces follow the folder, route and audience rule (ARCHITECTURE.md,
# "Names and places"), so an audience such as Me is a namespace. Only our own C# host uses these assemblies.
dotnet_code_quality.CA1716.analyzed_symbol_kinds = NamedType, Method, Property, Event, Parameter

# StyleCop.Analyzers checks the order of the members in a file and nothing else, so a reader finds the same kind of member in the same
# place in every file (the maintainer's decision in audit-g4): SA1201 (the order of the kinds of element), SA1202 (public before
# private), SA1203 (constants before fields) and SA1204 (static before instance). Every other StyleCop rule is off. SA0001 has no file,
# so Directory.Build.props turns it off.
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.LayoutRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.MaintainabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.NamingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.OrderingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.ReadabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpacingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpecialRules.severity = none
dotnet_diagnostic.SA1201.severity = warning
dotnet_diagnostic.SA1202.severity = warning
dotnet_diagnostic.SA1203.severity = warning
dotnet_diagnostic.SA1204.severity = warning

# Test names describe behaviour in words separated by underscores. A test project is known by its name, wherever it sits.
[**/*.{UnitTests,IntegrationTests,EndToEndTests,ArchitectureTests}/**.cs]
dotnet_diagnostic.CA1707.severity = none

# Migrations are written by `dotnet ef migrations add`; analyzers treat them as generated code.
[src/Modules/*/*.Infrastructure/Persistence/Migrations/*.cs]
generated_code = true

[src/Api/Persistence/Migrations/*.cs]
generated_code = true

# Wolverine's handler code is written by `codegen write` (W10); analyzers treat it as generated code.
[src/Api/Internal/Generated/**.cs]
generated_code = true
