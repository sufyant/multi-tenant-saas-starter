<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Notifications.Infrastructure" />
    <InternalsVisibleTo Include="Notifications.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" />
  </ItemGroup>

  <!-- The emails that pnpm generate renders from packages/emails, read by EmailTemplate under these names. A file such as
       invitation.en.html is no satellite resource of the culture en, so WithCulture is off. -->
  <ItemGroup>
    <EmbeddedResource Include="Email/Generated/*" LogicalName="Notifications.Email.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Notifications.Domain\Notifications.Domain.csproj" />
    <ProjectReference Include="..\Notifications.Contracts\Notifications.Contracts.csproj" />
    <ProjectReference Include="..\..\ControlPlane\ControlPlane.Contracts\ControlPlane.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Shared\SharedKernel\SharedKernel.csproj" />
  </ItemGroup>

</Project>
