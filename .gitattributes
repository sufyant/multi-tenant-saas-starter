# Generated files. A pull request folds each one, so a reviewer reads the source (GitHub Docs, "Customizing how changed files appear
# on GitHub"). apps/api/docs/ARCHITECTURE.md, "Generated files", lists each one with its source and its command.
*.g.cs linguist-generated=true
*.gen.ts linguist-generated=true
*.gen.css linguist-generated=true
apps/api/openapi/v1.json linguist-generated=true
# EF Core writes the designer file and the model snapshot of a migration. The migration itself is reviewed: it holds row level security.
*.Designer.cs linguist-generated=true
*ModelSnapshot.cs linguist-generated=true
# The emails that packages/emails renders into the API, with the data the API fills them with.
apps/api/src/Modules/Notifications/Notifications.Application/Email/Generated/** linguist-generated=true
